<section id="programs" class="college-programs pt-12">
  <div class="flex md:flex-col items-end md:items-start justify-between gap-4 pb-4">
    <div>
      <h2 class="text-darkgreen text-2xl font-display">Programs by Major</h2>
      <p class="pt-1 text-sm text-gray-500">
        <%= if @show_all do %>
          Every credential: certificates, associate's, bachelor's and graduate degrees.
        <% else %>
          Bachelor's degrees only. Click a column to sort.
        <% end %>
      </p>
    </div>
    <%= if @bachelors_count > 0 and @all_count > @bachelors_count do %>
      <.credential_toggle show_all={@show_all} bachelors_count={@bachelors_count} all_count={@all_count} />
    <% end %>
  </div>

  <%= if @rows == [] do %>
    <p class="text-gray-600">No program here reports debt or earnings.</p>
  <% else %>
    <div class="rounded-lg border border-gray-200 md:border-0">
      <table class="w-full md:block lg:table">
        <thead class="md:absolute md:-top-9999 md:-left-9999">
          <tr>
            <.sort_header label="Major" sort_key="name" current_sort={@sort_by} order={@order} tooltip="The field of study, as College Scorecard names it" />
            <%= if @show_all do %>
              <.sort_header label="Credential" sort_key="credential_level" current_sort={@sort_by} order={@order} tooltip="Degree type: Certificate, Associate's, Bachelor's, Master's, etc." />
            <% end %>
            <.sort_header label="Debt Mean" sort_key="debt_mean" current_sort={@sort_by} order={@order} tooltip="Average federal student-loan debt of graduates who borrowed. A few large loans can pull it up." />
            <.sort_header label="Debt Median" sort_key="debt_median" current_sort={@sort_by} order={@order} tooltip="Median federal student-loan debt of graduates who borrowed. Half owe more, half owe less." />
            <.sort_header label="Earnings" sort_key="earnings" current_sort={@sort_by} order={@order} tooltip="Median earnings 1 year after graduation for this major at this college" />
          </tr>
        </thead>
        <tbody class="md:block">
          <%= for major <- @rows do %>
            <tr class="md:block odd:bg-gray-50 hover:bg-lightgreen/10">
              <td class="px-4 py-3 major-field md:border-none md:relative md:block xl:text-sm border-b"><.link navigate={field_page_path(major.name)} class="no-underline text-green hover:underline"><%= field_short_name(major.name) %></.link></td>
              <%= if @show_all do %>
                <td class="px-4 py-3 cred-field md:border-none md:relative md:block xl:text-sm border-b"><%= degree(major.credential_level) %></td>
              <% end %>
              <td class={["px-4 py-3 debt-field md:border-none md:relative md:block xl:text-sm border-b tabular-nums", no_data?(major.debt_mean) && "text-gray-400"]}><%= cash(major.debt_mean) %></td>
              <td class={["px-4 py-3 debtmed-field md:border-none md:relative md:block xl:text-sm border-b tabular-nums", no_data?(major.debt_median) && "text-gray-400"]}><%= cash(major.debt_median) %></td>
              <td class={["px-4 py-3 earnings-field md:border-none md:relative md:block xl:text-sm border-b tabular-nums", no_data?(major.earnings) && "text-gray-400"]}><%= cash(major.earnings) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
  <.no_data_note count={@no_data_count} one="program here reports no debt or earnings." many="programs here report no debt or earnings." />
</section>
