<% net_prices = Collegevalue.Colleges.net_price_by_income(@college) %>
<% earnings_by_income = Collegevalue.Colleges.earnings_by_family_income(@college) %>
<% over_time = earnings_over_time(@college) %>
<% best_paid = best_paid_majors(@majors, 6) %>
<% website = website(@college.url) %>

<div>
  <header class="pb-6">
    <h1 class="text-darkgreen text-4xl md:text-3xl font-display"><%= @college.name %></h1>
    <p class="pt-1 text-sm text-gray-500">
      <%= if is_binary(@college.control) do %><%= control(@college.control) %> · <% end %><%= address(@college) %>
      <%= if website do %> · <a href={elem(website, 0)} class="no-underline text-green hover:underline" rel="nofollow"><%= elem(website, 1) %></a><% end %>
    </p>
  </header>

  <%= if @payoff do %>
    <dl class="college-stats grid grid-cols-4 lg:grid-cols-2 gap-4 pb-10">
      <.stat_card label="Months to repay" note="typical bachelor's program"><%= months(@payoff.months) %></.stat_card>
      <%= if @payoff.years do %>
        <.stat_card label="Years of pay" note="four years, for a $48–75k family"><%= years(@payoff.years) %></.stat_card>
      <% end %>
      <%= if @payoff.faster_than do %>
        <.stat_card label="Against other colleges" note={if @payoff.faster_than >= 50, do: "of colleges are slower to repay", else: "of colleges are faster to repay"}><%= if @payoff.faster_than >= 50, do: @payoff.faster_than, else: 100 - @payoff.faster_than %>%</.stat_card>
      <% end %>
      <%= if not no_data?(@college.netprice_3) do %>
        <.stat_card label="Price after aid" note="a year, for a family earning $48–75k"><%= cash(@college.netprice_3) %></.stat_card>
      <% end %>
    </dl>
  <% else %>
    <dl class="college-stats grid grid-cols-4 lg:grid-cols-2 gap-4 pb-10">
      <%= if not no_data?(@college.netprice_3) do %>
        <.stat_card label="Price after aid" note="a year, for a family earning $48–75k"><%= cash(@college.netprice_3) %></.stat_card>
      <% else %>
        <%= if not no_data?(@college.yearly_cost) do %>
          <.stat_card label="Cost per year" note="before grants and scholarships"><%= cash(@college.yearly_cost) %></.stat_card>
        <% end %>
      <% end %>
      <%= if not no_data?(@college.debt_median) do %>
        <.stat_card label="Student debt" note="median, for those who borrowed"><%= cash(@college.debt_median) %></.stat_card>
      <% end %>
      <%= if not no_data?(@college.earnings_median_after10) do %>
        <.stat_card label="Earnings" note="median, 10 years after starting"><%= cash(@college.earnings_median_after10) %></.stat_card>
      <% end %>
      <%= if not no_data?(@college.fouryear_150_completion) do %>
        <.stat_card label="Graduate" note="within six years"><%= percent(@college.fouryear_150_completion) %></.stat_card>
      <% end %>
    </dl>
  <% end %>

  <div class="grid grid-cols-3 lg:grid-cols-1 gap-12 lg:gap-8">
    <section class="college-summary col-span-2 lg:col-span-1 text-lg leading-relaxed text-gray-800 space-y-5">
      <%= if @payoff do %>
        <h2 class="text-darkgreen text-2xl font-display">Is <%= @college.name %> Worth It?</h2>
        <p class="college-payoff"><%= Enum.join(college_payoff_sentences(@college.name, @payoff), " ") %></p>
      <% end %>
      <p><%= college_summary(@college) %></p>
    </section>
    <aside>
      <dl class="rounded-lg bg-gray-50 border border-gray-200 p-5 text-sm leading-6 space-y-2">
        <%= if not no_data?(@college.admissions_rate) do %>
          <div class="flex justify-between gap-4"><dt class="text-gray-500">Admit rate</dt><dd class="tabular-nums"><%= percent(@college.admissions_rate) %></dd></div>
        <% end %>
        <%= if not no_data?(@college.sat_avg) do %>
          <div class="flex justify-between gap-4"><dt class="text-gray-500">Average SAT</dt><dd class="tabular-nums"><%= sat(@college.sat_avg) %></dd></div>
        <% end %>
        <div class="flex justify-between gap-4"><dt class="text-gray-500">Sticker price</dt><dd class="tabular-nums"><%= cash(@college.yearly_cost) %> a year</dd></div>
        <div class="flex justify-between gap-4"><dt class="text-gray-500">Accreditor</dt><dd class="text-right"><%= accreditation(defaults(@college.accreditation)) %></dd></div>
        <p class="pt-2"><a href="#programs" class="no-underline text-green hover:underline">See every program by major ↓</a></p>
      </dl>
    </aside>
  </div>

  <div class="grid grid-cols-2 lg:grid-cols-1 items-start gap-8 pt-12">
    <%= if net_prices != [] do %>
      <section class="rounded-lg border border-gray-200 p-6">
        <h2 class="text-darkgreen text-xl font-display">What Families Pay</h2>
        <p class="pt-1 pb-4 text-sm text-gray-500">A year after grants, by family income, for aided first-time students.</p>
        <% max_price = Enum.max([@college.yearly_cost || 0 | Enum.map(net_prices, &elem(&1, 1))]) %>
        <%= for {label, price} <- net_prices do %>
          <.bar_row label={label} value={price} max={max_price} />
        <% end %>
        <p class="pt-4 text-sm text-gray-500">
          Sticker price <%= cash(@college.yearly_cost) %> a year<%= cond do %>
            <% no_data?(@college.tuition_in) -> %>.
            <% @college.tuition_in == @college.tuition_out or no_data?(@college.tuition_out) -> %>, with tuition and fees of <%= cash(@college.tuition_in) %>.
            <% true -> %>, with tuition and fees of <%= cash(@college.tuition_in) %> in state and <%= cash(@college.tuition_out) %> out of state.
          <% end %>
        </p>
      </section>
    <% end %>

    <section class="rounded-lg border border-gray-200 p-6">
      <h2 class="text-darkgreen text-xl font-display">Debt and Finishing</h2>
      <p class="pt-1 pb-4 text-sm text-gray-500">Median federal student-loan debt, and the share of full-time first-time students who finish.</p>
      <dl class="space-y-2 text-sm pb-6">
        <div class="flex justify-between gap-4"><dt class="text-gray-700">All borrowers</dt><dd class="tabular-nums"><%= cash(defaults(@college.debt_median)) %></dd></div>
        <div class="flex justify-between gap-4"><dt class="text-gray-700">Those who graduated</dt><dd class="tabular-nums"><%= cash(@college.graduated_debt_median) %></dd></div>
        <div class="flex justify-between gap-4"><dt class="text-gray-700">Those who left without a degree</dt><dd class="tabular-nums"><%= cash(@college.withdrawn_debt_median) %></dd></div>
      </dl>
      <%= if Enum.any?([@college.fouryear_100_completion, @college.fouryear_150_completion, @college.fouryear_200_completion], &(not no_data?(&1))) do %>
        <div class="flex items-center justify-between pb-2">
          <span class="text-sm text-gray-700">Finished within</span>
          <.completion_badge rate={@college.fouryear_200_completion} />
        </div>
        <.completion_bar rate={@college.fouryear_100_completion} label="4 years" />
        <.completion_bar rate={@college.fouryear_150_completion} label="6 years" />
        <.completion_bar rate={@college.fouryear_200_completion} label="8 years" />
      <% end %>
    </section>

    <%= if over_time != [] do %>
      <section class="rounded-lg border border-gray-200 p-6">
        <h2 class="text-darkgreen text-xl font-display">Earnings Over Time</h2>
        <p class="pt-1 pb-4 text-sm text-gray-500">Median earnings of federally aided students, counted from the year they started.</p>
        <% max_earned = over_time |> Enum.map(&elem(&1, 1)) |> Enum.max() %>
        <%= for {label, amount} <- over_time do %>
          <.bar_row label={label} value={amount} max={max_earned} />
        <% end %>
      </section>
    <% end %>

    <%= if @payoff do %>
      <section class="payoff-majors rounded-lg border border-gray-200 p-6">
        <h2 class="text-darkgreen text-xl font-display">Fastest and Slowest to Repay</h2>
        <p class="pt-1 pb-4 text-sm text-gray-500">Months of first-year pay to equal the median student debt, for <%= @payoff.programs %> bachelor's programs here that report both.</p>
        <%= for {label, list} <- [{"Fastest", @payoff.fastest}, {"Slowest", @payoff.slowest}] do %>
          <p class="pt-2 pb-1 text-xs uppercase tracking-wider text-gray-500"><%= label %></p>
          <dl class="space-y-1.5 text-sm">
            <%= for program <- list do %>
              <div class="flex justify-between gap-4">
                <dt><a href={field_page_path(program.field_name)} class="no-underline text-green hover:underline"><%= field_short_name(program.field_name) %></a></dt>
                <dd class="tabular-nums whitespace-nowrap"><%= months(program.months) %><span class="text-gray-500"> · <%= cash(program.payoff) %> pay</span></dd>
              </div>
            <% end %>
          </dl>
        <% end %>
        <p class="pt-4 text-xs text-gray-500">Majors that lead to graduate school, like biology, look slow here because many graduates are still in school a year out.</p>
      </section>
    <% end %>

    <%= if best_paid != [] and is_nil(@payoff) do %>
      <section class="rounded-lg border border-gray-200 p-6">
        <h2 class="text-darkgreen text-xl font-display">Best-Paid Majors</h2>
        <p class="pt-1 pb-4 text-sm text-gray-500">Median earnings one year after a bachelor's here, with the median debt beneath.</p>
        <% max_major = best_paid |> hd() |> Map.get(:earnings) %>
        <%= for major <- best_paid do %>
          <.bar_row label={field_short_name(major.name)} value={major.earnings} max={max_major} note={if no_data?(major.debt_median), do: nil, else: "#{cash(major.debt_median)} debt"}>
            <a href={field_page_path(major.name)} class="no-underline text-green hover:underline" title={field_short_name(major.name)}><%= field_short_name(major.name) %></a>
          </.bar_row>
        <% end %>
      </section>
    <% end %>
  </div>

  <%= if earnings_by_income != [] do %>
    <section class="pt-12">
      <h2 class="text-darkgreen text-2xl font-display">What Graduates Earn by Family Background</h2>
      <p class="pt-1 pb-4 text-sm text-gray-500">Median earnings by family income tercile, 6, 8 and 10 years after starting.</p>
      <% earn_data = Poison.encode!(income_earnings_chart_data(earnings_by_income)) %>
      <%= raw Chartkick.column_chart(earn_data, prefix: "$", width: "100%", colors: ["#1a93df", "#88d498", "#114b5f"], library: %{
        scales: %{
          yAxes: [%{ticks: %{beginAtZero: true}}]
        }
      }) %>
    </section>
  <% end %>
</div>
