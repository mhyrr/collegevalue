<h1 class="text-xl text-darkgreen"><%= field_short_name(@field.name) %></h1>
<%= if field_short_name(@field.name) != @field.name do %>
  <p class="text-sm text-gray-600">College Scorecard field: <%= @field.name %></p>
<% end %>
<p class="mt-4 max-w-3xl text-base leading-6 text-gray-900"><%= field_summary(@field) %></p>

<%= if @facts do %>
  <section class="mt-6 max-w-3xl space-y-3 text-base leading-6 text-gray-900">
    <h2 class="text-lg text-darkgreen"><%= field_question(@field.name) %></h2>
    <p><%= Enum.join(field_answer(@facts), " ") %></p>
    <%= for paragraph <- @note do %>
      <p><%= for part <- paragraph do %><%= case part do %><% {name, unitid} -> %><%= link name, to: Routes.college_path(@socket, :show, unitid, name), class: "no-underline text-green" %><% text -> %><%= text %><% end %><% end %></p>
    <% end %>
    <p class="text-sm text-gray-600">
      These are earnings one year after graduating, for students who received federal aid.
      Debt is the median federal student-loan debt of graduates who borrowed; it leaves out loans parents took.
      Majors that lead to graduate school, or to careers that start slowly, look worse here than they will ten years on.
    </p>
  </section>
<% end %>

<div class="flex py-2 px-4 rounded overflow-hidden ">
            <div class="flex-shrink-0">

              <div class="flex items-center justify-center h-12 w-12 rounded-md">

              </div>
            </div>
            <div class="ml-4">
                <h4 class="text-lg leading-6 font-medium text-darkgreen">Details</h4>
                <ul class="list-none">
                  <li><strong class="text-green">Number of Offering Colleges:</strong> <%= @field.count %></li>
                  <li><strong class="text-green">Student-Loan Debt, Average Program:</strong> <%= cash(@field.debt_avg) %></li>
                  <li><strong class="text-green">Expected Earnings 1 Year After:</strong> <%= cash(@field.earn_avg) %></li>

                </ul>

            </div>
          </div>


<div class="w-full">
    <button class="bg-transparent hover:bg-black-500 text-green font-semibold hover:text-green py-2 px-4 border border-green rounded" phx-click="toggle_credentials"><%= @cred_label %></button>
</div>


<table  class="md:block lg:table pt-8">
  <thead class="md:absolute md:-top-9999 md:-left-9999">
    <tr>
      <.sort_header_link label="Name" sort_key="name" current_sort={@sort_by} order={@order || "desc"} patch_url={field_page_path(@field.name, %{sort_by: "name", order: @order || "desc"})} />
      <.sort_header_link label="Credential" sort_key="credential_level" current_sort={@sort_by} order={@order || "desc"} patch_url={field_page_path(@field.name, %{sort_by: "credential_level", order: @order || "desc"})} tooltip="Degree type: Certificate, Associate's, Bachelor's, Master's, etc." />
      <.sort_header_link label="Debt Mean" sort_key="debt_mean" current_sort={@sort_by} order={@order || "desc"} patch_url={field_page_path(@field.name, %{sort_by: "debt_mean", order: @order || "desc"})} tooltip="Average federal student-loan debt of graduates who borrowed. A few large loans can pull it up." />
      <.sort_header_link label="Debt Median" sort_key="debt_median" current_sort={@sort_by} order={@order || "desc"} patch_url={field_page_path(@field.name, %{sort_by: "debt_median", order: @order || "desc"})} tooltip="Median federal student-loan debt of graduates who borrowed. Half owe more, half owe less." />
      <.sort_header_link label="Earnings" sort_key="earnings" current_sort={@sort_by} order={@order || "desc"} patch_url={field_page_path(@field.name, %{sort_by: "earnings", order: @order || "desc"})} tooltip="Median earnings 1 year after graduation for this major" />
    </tr>
  </thead>
  <tbody class="md:block">
    <%= for major <- @majors do %>
      <%= if @show_all || major.credential_level == 3 do %>
        <tr class="md:block odd:bg-gray-50">
        <td class="px-4 py-3 college-field md:border-none md:relative md:block xl:text-sm whitespace-wrap border-b "><%= link major.college_name, to: Routes.college_path(@socket, :show, major.unit_id, major.college_name), class: "no-underline text-green" %> </td>
        <td class="px-4 py-3 cred-field md:border-none md:relative md:block xl:text-sm whitespace-wrap border-b"><%= degree(major.credential_level) %></td>
        <td class="px-4 py-3 debt-field md:border-none md:relative md:block xl:text-sm whitespace-wrap border-b"><%= cash(major.debt_mean) %></td>
        <td class="px-4 py-3 debtmed-field md:border-none md:relative md:block xl:text-sm whitespace-wrap border-b"><%= cash(major.debt_median) %></td>
        <td class="px-4 py-3 earnings-field md:border-none md:relative md:block xl:text-sm whitespace-wrap border-b"><%= cash(major.earnings) %></td>

        </tr>
      <% end %>
    <% end %>
  </tbody>
</table>



<%!-- Now render a fierw for a list of disciplines pulled for this field! --%>

