<% {measure, dir} = field_ranking(@ranking) %>
<% earnings_view? = measure == "pay" %>
<% link_to = fn m, d ->
  params = %{rank: field_ranking_key(m, d)}
  params = if @count == 100, do: params, else: Map.put(params, :count, @count)
  params = if m == "pay" and @require_debt, do: Map.put(params, :require_debt, true), else: params
  Routes.field_path(@conn, :rank, params)
end %>

<div class="rank-page py-8 px-4 md:px-0 md:py-4">
  <header class="pb-6">
    <h1 class="text-darkgreen text-4xl md:text-3xl font-display">College Majors Ranked by Earnings vs. Debt</h1>
    <p class="pt-3 max-w-3xl text-lg leading-relaxed text-gray-800">
      Every bachelor's program in the College Scorecard, one college and one major at a time, ranked by how fast its graduates can repay what they borrowed,
      or by how many years of pay four years there cost.
    </p>
  </header>

  <div class="rank-controls flex flex-wrap items-end gap-x-8 gap-y-4 rounded-lg border border-gray-200 bg-white p-4">
    <div>
      <p class="pb-1 text-xs uppercase tracking-wider text-gray-500">Rank by</p>
      <.link_switch label="Rank by" items={for {m, label, _, _} <- field_measures(), do: {label, link_to.(m, dir), m == measure}} />
    </div>
    <div>
      <p class="pb-1 text-xs uppercase tracking-wider text-gray-500">Order</p>
      <.link_switch label="Order" items={[{"Best first", link_to.(measure, "top"), dir == "top"}, {"Worst first", link_to.(measure, "bottom"), dir == "bottom"}]} />
    </div>
    <%= form_for @conn, Routes.field_path(@conn, :rank), [method: :get, class: "flex flex-wrap items-end gap-x-6 gap-y-3 ml-auto md:ml-0"], fn f -> %>
      <%= hidden_input f, :rank, value: @ranking %>
      <div>
        <label for="income_select" class="block pb-1 text-xs uppercase tracking-wider text-gray-500">Family income</label>
        <%= select f, :income, income_bracket_options(), id: "income_select", value: @income, onchange: "this.form.submit()", class: "form-input rounded-md border-gray-200 py-1.5 pl-3 pr-8 text-sm" %>
      </div>
      <div>
        <label for="count_select" class="block pb-1 text-xs uppercase tracking-wider text-gray-500">Show</label>
        <%= select f, :count, @rank_counts, id: "count_select", value: @count, onchange: "this.form.submit()", class: "form-input rounded-md border-gray-200 py-1.5 pl-3 pr-8 text-sm" %>
      </div>
      <%= if earnings_view? do %>
        <label class="inline-flex items-center pb-2 text-sm text-gray-700 cursor-pointer">
          <%= checkbox f, :require_debt, value: @require_debt, onchange: "this.form.submit()", class: "form-checkbox mr-2" %>
          Only majors that report debt
        </label>
      <% end %>
    <% end %>
  </div>

  <div class="rank-summary pt-4 pb-4 space-y-2 text-sm text-gray-600">
    <p>
      <span class="font-bold text-darkgreen"><%= field_rank_heading(@ranking) %></span>, for bachelor's degrees.
      Costs are for families earning <%= income_bracket_label(@income) %> a year. <a href="#how-we-figure" class="no-underline text-green hover:underline">How we figure these</a>
    </p>
    <%= if grad_school_note?(@ranking) do %>
      <p class="grad-school-note text-gray-900 bg-amber-50 border-l-4 border-amber-400 px-3 py-2">
        Majors that lead to graduate school, like communication disorders or pre-physical therapy, show low first-year pay because many graduates are still in school.
      </p>
    <% end %>
  </div>

  <%= if @ranks == [] do %>
    <p class="text-gray-600">No program reports the figures for this ranking.</p>
  <% else %>
    <div class="rounded-lg border border-gray-200 md:hidden">
      <table class="rank-table w-full">
        <thead>
          <tr>
            <.header label="#" />
            <.header label="Major and College" tooltip="The major, and the college that offers it. Each college's program is ranked on its own." />
            <.header label="Admit Rate" tooltip_key="admissions" />
            <.header label="4-Year Cost" tooltip_key="cost4" />
            <.header label="Debt" tooltip="The median federal student-loan debt of graduates of this major who borrowed. Parent PLUS loans are not included." />
            <.header label="First-Year Pay" tooltip="Median earnings 1 year after graduation for this major at this college" />
            <.header label="Months to Repay" tooltip_key="months" />
            <.header label="Years of Pay" tooltip_key="value_years" />
          </tr>
        </thead>
        <tbody>
          <%= for {rank, i} <- Enum.with_index(@ranks, 1) do %>
            <tr class="odd:bg-gray-50 hover:bg-lightgreen/10">
              <td class="px-4 py-3 border-b text-sm text-gray-400 tabular-nums"><%= i %></td>
              <td class="px-4 py-3 border-b text-sm">
                <%= link field_short_name(rank.field_name), to: field_page_path(rank.field_name), class: "no-underline text-green font-bold hover:underline" %>
                <span class="block">
                  <%= link rank.college_name, to: college_page_path(rank.unit_id, rank.college_name), class: "no-underline text-gray-700 hover:underline" %>
                </span>
                <%= if place = rank_place(rank) do %><span class="block text-xs text-gray-500"><%= place %></span><% end %>
              </td>
              <td class="px-4 py-3 border-b text-sm tabular-nums">
                <span class={no_data?(rank.admissions) && "text-gray-400"}><%= percent(rank.admissions) %></span>
                <%= if not no_data?(rank.sat_avg) do %><span class="block text-xs text-gray-500">SAT <%= sat(rank.sat_avg) %></span><% end %>
              </td>
              <.cost_cell net_price={rank.net_price} sticker={rank.sticker} debt={rank.cost} gap_as_tip />
              <td class={["px-4 py-3 border-b text-sm tabular-nums", no_data?(rank.cost) && "text-gray-400"]}><%= cash(rank.cost) %></td>
              <td class={["px-4 py-3 border-b text-sm tabular-nums", earnings_view? && "font-bold text-base"]}><%= cash(rank.payoff) %></td>
              <.months_cell value={rank.months} parent_debt={rank.parent_debt} earnings={rank.payoff} />
              <.years_cell value={rank.value_years} bold={measure == "value"} />
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <ol class="rank-cards hidden md:block space-y-3">
      <%= for {rank, i} <- Enum.with_index(@ranks, 1) do %>
        <li class="rounded-lg border border-gray-200 p-4">
          <div class="flex items-baseline gap-3">
            <span class="text-sm text-gray-400 tabular-nums"><%= i %></span>
            <div class="flex-1">
              <%= link field_short_name(rank.field_name), to: field_page_path(rank.field_name), class: "no-underline text-green font-bold" %>
              <span class="block text-sm"><%= link rank.college_name, to: college_page_path(rank.unit_id, rank.college_name), class: "no-underline text-gray-700" %></span>
              <%= if place = rank_place(rank) do %><span class="block text-xs text-gray-500"><%= place %></span><% end %>
            </div>
          </div>
          <p class="pt-2 text-2xl font-display text-darkgreen tabular-nums">
            <%= case measure do %>
              <% "repay" -> %><%= months(rank.months) %> <span class="text-sm text-gray-500 font-body">to repay</span>
              <% "value" -> %><%= years(rank.value_years) %> <span class="text-sm text-gray-500 font-body">of pay for the cost</span>
              <% _ -> %><%= cash(rank.payoff) %> <span class="text-sm text-gray-500 font-body">first-year pay</span>
            <% end %>
          </p>
          <dl class="grid grid-cols-2 gap-x-4 gap-y-1 pt-2 text-sm">
            <dt class="text-gray-500">First-year pay</dt><dd class="tabular-nums text-right"><%= cash(rank.payoff) %></dd>
            <dt class="text-gray-500">Debt</dt><dd class="tabular-nums text-right"><%= cash(rank.cost) %></dd>
            <dt class="text-gray-500">4-year cost</dt><dd class="tabular-nums text-right"><%= cash(Collegevalue.Fields.four_year_cost(rank.net_price)) %></dd>
            <dt class="text-gray-500">Months to repay</dt><dd class="tabular-nums text-right"><%= months(rank.months) %></dd>
            <dt class="text-gray-500">Years of pay</dt><dd class="tabular-nums text-right"><%= years(rank.value_years) %></dd>
            <dt class="text-gray-500">Admit rate</dt><dd class="tabular-nums text-right"><%= percent(rank.admissions) %></dd>
          </dl>
        </li>
      <% end %>
    </ol>
  <% end %>

  <section id="how-we-figure" class="pt-12 grid grid-cols-3 lg:grid-cols-1 gap-12 lg:gap-8 text-gray-700">
    <div class="col-span-2 lg:col-span-1 space-y-4 leading-relaxed">
      <h2 class="text-darkgreen text-2xl font-display">How We Figure These</h2>
      <p>
        <strong>Months to repay</strong> divides a program's median federal student-loan debt by one month of its graduates' median pay in their first year.
        At 6 months, the typical borrower owes about half a year's pay. It uses gross pay, before taxes, rent and other bills, so paying the loans off really takes longer.
        It counts only graduates who borrowed, and leaves out loans their parents took. Programs that don't report their debt aren't ranked.
      </p>
      <p>
        <strong>Parent loans.</strong> When parents who took Parent PLUS loans owed more than <%= parent_plus_warning_months() %> months of their child's first-year pay, a note shows that figure on its own.
        We never add it to the student's debt.
      </p>
      <p>
        <strong>Four-year cost</strong> is a year's cost after grants, times four. It includes housing, food and books.
        It is the average for aided first-time full-time students in the family income bracket you pick, reported for the whole school rather than each major.
        It assumes you finish in four years. Families who get no aid pay closer to the sticker price, shown beneath it.
      </p>
      <p>
        <strong>The gap</strong> is the four-year cost minus the median federal student loan. A family covers it from savings, work, Parent PLUS or private loans.
        Hover the <span class="inline-flex items-center justify-center w-4 h-4 rounded-full bg-gray-200 text-gray-500 text-[10px] font-bold">?</span> beside a sticker price to see it.
      </p>
      <p>
        <strong>Years of pay</strong> divides the four-year cost by a year of first-year pay. At 2.0 years, the degree costs two years of a graduate's first-year pay.
      </p>
    </div>
    <aside>
      <div class="rounded-lg bg-gray-50 border border-gray-200 p-5 text-sm leading-6 text-gray-600 space-y-3">
        <p class="font-bold text-darkgreen">Where the numbers come from</p>
        <p>All data comes from the U.S. Department of Education's College Scorecard: first-year earnings and federal debt for students who received federal aid.</p>
        <p>To compare whole colleges, see <a href="/colleges/rank" class="no-underline text-green hover:underline">best value colleges</a>.</p>
      </div>
    </aside>
  </section>
</div>
